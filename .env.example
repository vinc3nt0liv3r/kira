# Copy to .env and adjust before `docker compose up -d`.

# Postgres password for the bundled database (may contain URL-reserved characters).
POSTGRES_PASSWORD=change-me

# Dashboard port on the host (the app listens on port 8080 inside its container).
API_PORT=8082

# Host interface for published ports. Use 127.0.0.1 to prevent LAN access.
HOST_BIND_IP=0.0.0.0

# Syslog port exposed to firewalls (UDP and TCP).
SYSLOG_PORT=5514

# Raw-event search window. Older hourly partitions are rolled up before being dropped.
RETENTION_HOURS=6
PARTITIONS_AHEAD_HOURS=48
KEEP_EXTENDED_ATTRIBUTES=false

# Optional: set a random secret of at least 32 characters to enable retention changes
# in the dashboard. Preview remains available when this is unset.
# Generate one with: openssl rand -hex 32
# RETENTION_ADMIN_TOKEN=

# Flush larger batches to reduce Postgres WAL fsync overhead at high log rates.
# At about 1,000 events/sec this adds at most 2 seconds of ingest latency.
BATCH_SIZE=5000
BATCH_MS=2000

# Default site shown in the dashboard.
TENANT_SLUG=default
TENANT_NAME=Head office

# Multi-tenant routing: source CIDR=tenant-slug pairs (comma separated).
# Leave empty for a single site. Tenants are created on first matching log.
# TENANT_MAP=192.0.2.0/24=acme,198.51.100.10=branch

# Optional allow-list of log sources (CIDR or IP, comma separated).
# ALLOWED_SOURCES=192.0.2.0/24

# Dashboard API
API_STATEMENT_TIMEOUT_MS=10000
API_MAX_CONCURRENT_QUERIES=4
DB_POOL_SIZE=8

# Offset (minutes) used when a device sends a timezone abbreviation the
# collector does not recognize. UTC is 0.
TZ_OFFSET_MINUTES=0

# Set to debug for per-batch timing and rejected-line reasons.
RUST_LOG=info
